generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("CASHIER")
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sales        Sale[]
  purchases    Purchase[]
  activityLogs ActivityLog[]

  @@index([email])
  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?   @default("#6366f1")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]

  @@index([phone])
  @@map("customers")
}

model Product {
  id               String            @id @default(cuid())
  name             String
  sku              String            @unique
  barcode          String?           @unique
  description      String?
  categoryId       String?
  costPrice        Float
  sellingPrice     Float
  stock            Int               @default(0)
  minimumStock     Int               @default(5)
  unit             String            @default("pcs")
  image            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id])
  saleItems        SaleItem[]
  supplierProducts SupplierProduct[]
  purchaseItems    PurchaseItem[]

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id            String            @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  products      SupplierProduct[]
  purchases     Purchase[]
  payments      SupplierPayment[]

  @@map("suppliers")
}

model SupplierProduct {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  createdAt  DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

model Purchase {
  id             String    @id @default(cuid())
  purchaseNumber String    @unique
  supplierId     String
  userId         String
  subtotal       Float
  discount       Float     @default(0)
  total          Float
  amountPaid     Float     @default(0)
  status         String    @default("RECEIVED")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  items          PurchaseItem[]
  payments       SupplierPayment[]

  @@index([supplierId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  productId    String
  productName  String
  sku          String
  quantity     Int
  unitCost     Float
  subtotal     Float
  createdAt    DateTime @default(now())

  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  purchaseId String?
  amount     Float
  method     String   @default("CASH")
  notes      String?
  createdAt  DateTime @default(now())

  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([supplierId])
  @@map("supplier_payments")
}

model Sale {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  userId        String
  customerId    String?
  subtotal      Float
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float
  paymentMethod String   @default("CASH")
  cashAmount    Float?
  cardAmount    Float?
  change        Float?
  status        String   @default("COMPLETED")
  notes         String?
  customerName  String?
  customerPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  items         SaleItem[]

  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([receiptNumber])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  productName String
  sku         String
  quantity    Int
  costPrice   Float
  unitPrice   Float
  subtotal    Float
  createdAt   DateTime @default(now())

  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Notification {
  id           String   @id @default(cuid())
  type         String
  title        String
  message      String
  isRead       Boolean  @default(false)
  sentEmail    Boolean  @default(false)
  sentWhatsApp Boolean  @default(false)
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([isRead])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model PrinterSettings {
  id          String   @id @default(cuid())
  type        String   @unique
  printerName String?
  paperSize   String   @default("80mm")
  headerTitle String?
  logo        String?
  showLogo    Boolean  @default(false)
  footer      String?
  showFooter  Boolean  @default(true)
  copies      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("printer_settings")
}

model SystemSettings {
  id                  String    @id @default(cuid())
  systemName          String    @default("POS System")
  logo                String?
  currency            String    @default("LKR")
  currencySymbol      String    @default("Rs.")
  timezone            String    @default("Asia/Colombo")
  taxRate             Float     @default(0)
  theme               String    @default("light")
  address             String?
  phone               String?
  email               String?
  kotEnabled          Boolean   @default(false)
  printerIp           String?
  printerEnabled      Boolean   @default(false)
  slogan              String?
  whatsApp            String?
  receiptNote         String?
  thankYouLine1       String    @default("THANK YOU FOR YOUR VISIT")
  thankYouLine2       String    @default("COME AGAIN!")
  printAgentUrl       String    @default("http://localhost:3001")
  licenseKey          String?
  licenseActivatedAt  DateTime?
  licenseType         String    @default("TRIAL")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("system_settings")
}

model Employee {
  id               String    @id @default(cuid())
  employeeId       String    @unique
  fullName         String
  nicNumber        String?   @unique
  dateOfBirth      DateTime?
  gender           String?
  contactNumber    String?
  email            String?
  address          String?
  emergencyContact String?
  dateJoined       DateTime  @default(now())
  position         String    @default("Cashier")
  department       String?
  basicSalary      Float     @default(0)
  employmentType   String    @default("FULL_TIME")
  photo            String?
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attendance       Attendance[]
  payroll          Payroll[]
  performanceNotes PerformanceNote[]

  @@index([isActive])
  @@map("employees")
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  createdAt  DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model Payroll {
  id            String    @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  basicSalary   Float
  workingDays   Int       @default(0)
  presentDays   Int       @default(0)
  overtimeHours Float     @default(0)
  overtimeRate  Float     @default(0)
  allowances    Float     @default(0)
  deductions    Float     @default(0)
  bonus         Float     @default(0)
  advance       Float     @default(0)
  netSalary     Float
  status        String    @default("PENDING")
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@map("payroll")
}

model PerformanceNote {
  id          String   @id @default(cuid())
  employeeId  String
  type        String   @default("NOTE")
  title       String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("performance_notes")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6366f1")
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String           @id @default(cuid())
  title         String
  amount        Float
  categoryId    String?
  date          DateTime         @default(now())
  paymentMethod String           @default("CASH")
  reference     String?
  notes         String?
  receipt       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@map("expenses")
}

model Investment {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("INITIAL")
  amount      Float
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("investments")
}

model Asset {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("EQUIPMENT")
  purchaseCost Float
  currentValue Float
  purchaseDate DateTime
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@map("assets")
}

model CustomerCredit {
  id           String   @id @default(cuid())
  customerId   String?
  customerName String?
  type         String   @default("CREDIT")
  amount       Float
  saleId       String?
  notes        String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([date])
  @@map("customer_credits")
}
